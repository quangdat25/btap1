    "test:browser": "npm run build && node scripts/browser-check.mjs",
    "backup": "node scripts/backup.mjs"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "nodemailer": "^10.6.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "prettier": "^3.10.1",
    "vite": "^8.3.6"
  }
}
