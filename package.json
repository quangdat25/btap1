{
  "name": "techcamp-vocabulary",
  "private": true,
  "engines": {
    "node": ">=22.21.0"
  },
  "version": "0.0.0",
  "type": "module",
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite",
    "dev:server": "node --watch server/index.mjs",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "node server/index.mjs",
    "start": "node server/index.mjs",
